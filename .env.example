# Discord TTS Bot (Rust) — configuración

# Ruta en el host donde se persisten los datos del bot (settings.redb, etc.)
# Se monta en /opt/app/data dentro del contenedor.
DISCORD_TTS_DATA=/data/discord-tts

# Token del bot de Discord (obtenlo en https://discord.com/developers/applications)
DISCORD_TOKEN=your-discord-bot-token-here

# (Opcional) ID de un servidor de pruebas para registrar los slash commands al instante
# durante el desarrollo, en lugar de esperar la propagación global de Discord.
TESTING_GUILD_ID=

# (Opcional) Habilita el comportamiento de canales TTS automáticos (true/1)
ENABLE_TTS_CHANNELS=false

# Zona horaria del contenedor
TZ=America/Guayaquil
